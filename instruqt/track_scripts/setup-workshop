#!/usr/bin/env bash
# Track setup: start the watchdog, which starts the Temporal dev server and keeps
# it answering, then the control plane, which starts the stubs, the order app and
# the Worker itself. Everything is installed in the image, so this only clears old
# ledgers and starts processes.
set -euo pipefail
IFS=$'\t\n'

# --- wait for Instruqt ------------------------------------------------------

# Instruqt sets this file when the sandbox is ready. Outside Instruqt, for a local
# test, set SKIP_INSTRUQT_BOOTSTRAP=1.
if [ "${SKIP_INSTRUQT_BOOTSTRAP:-0}" != "1" ]; then
    until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do sleep 1; done
fi

# --- helpers ----------------------------------------------------------------

# Runs the command after the name once a second until it succeeds, giving up
# after 60 tries. Each command passed in carries its own time limit, so a try
# can't hang.
wait_for() {
    local name="$1"
    shift
    for _ in $(seq 1 60); do
        if "$@" >/dev/null 2>&1; then
            echo "$name is up"
            return 0
        fi
        sleep 1
    done
    echo "$name did not start" >&2
    return 1
}

# --- Temporal dev server, through the watchdog ------------------------------

# The watchdog starts the server, restarts it if it dies or stops answering, and
# keeps its own log, which the cleanup script prints into Instruqt's lifecycle log.
nohup /root/workshop/sandbox/temporal-watchdog > /dev/null 2>&1 &
wait_for "Temporal dev server" timeout 2 temporal operator cluster health --address 127.0.0.1:7233

# --- control plane ----------------------------------------------------------

cd /root/workshop
rm -f logs/*-ledger.json logs/*-ledger.tmp
nohup uv run python -m uvicorn delivery.control_plane:app --host 0.0.0.0 --port 8085 \
    > /tmp/control-plane.log 2>&1 &
wait_for "Chaos panel" curl -sf -m 2 http://127.0.0.1:8085/state
